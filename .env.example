FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# If set, every /api/v1 and /api/mcp request needs "Authorization: Bearer <key>"
# STALE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Accounts/sessions store. Leave unset locally (uses data/stale.db). On Vercel use Turso (turso.tech):
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=
# Random string used to encrypt integration tokens at rest (set this in production)
# STALE_SECRET=
