# --- FalkorDB (knowledge graph). Local: docker compose up. Production: FalkorDB Cloud ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# --- Accounts / sessions store (libSQL) ---
# Leave unset locally to use the file data/stale.db. On Vercel use Turso (turso.tech).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Secrets ---
# Long random string used to encrypt integration tokens at rest (set this in production)
STALE_SECRET=
# Optional: only needed with STALE_AUTH=off; then every /api/v1 and /api/mcp request needs "Authorization: Bearer <key>"
# STALE_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Billing (Razorpay one-time payments). Leave unset to run with no plan limits (self-hosted). ---
# Dashboard -> Account & Settings -> API keys. Use rzp_test_ keys while testing.
RAZORPAY_API_KEY=
RAZORPAY_SECRET=
# Optional backup if a customer pays then closes the tab: Dashboard -> Settings -> Webhooks ->
# https://YOUR-HOST/api/hooks/razorpay with the event order.paid and a secret of your choice
RAZORPAY_WEBHOOK_SECRET=
